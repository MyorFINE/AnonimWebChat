# Nusxa oling: cp .env.example .env   (barcha qiymatlar ixtiyoriy)
TERMCHAT_HOST=0.0.0.0
TERMCHAT_PORT=8000
TERMCHAT_DATA_DIR=./data
# @Hevorix (platforma egasi) paroli. Bermasangiz, birinchi ishga tushirishda tasodifiy parol yaratilib logga yoziladi.
TERMCHAT_ADMIN_PASSWORD=
# Render/Cloudflare ortida CF-Connecting-IP sarlavhasiga ishonish (haqiqiy IP aniqlash uchun)
TERMCHAT_TRUST_PROXY=1
# Chatga yuboriladigan har qanday fayl (rasm, video, hujjat...) chegarasi, bayt (standart 50 MB)
TERMCHAT_MAX_MEDIA_BYTES=52428800
TERMCHAT_ACTIVITY_DAYS=90
TERMCHAT_TZ_OFFSET=5
TERMCHAT_MAX_MESSAGE_LENGTH=1000
TERMCHAT_HISTORY_LIMIT=100
TERMCHAT_MAX_AVATARS=3
TERMCHAT_MSG_RATE_COUNT=5
TERMCHAT_MSG_RATE_WINDOW=5
TERMCHAT_LOGIN_ATTEMPTS=8
TERMCHAT_LOGIN_WINDOW=300
TERMCHAT_REGISTER_ATTEMPTS=10
TERMCHAT_REGISTER_WINDOW=3600
TERMCHAT_DEFAULT_MUTE_MINUTES=10

# --- Xavfsizlik ---
# Bazadagi xabarlar/loglarni shifrlash kaliti (kamida 16 belgi, tasodifiy uzun qator tavsiya). Bo'sh bo'lsa data/master.key yaratiladi.
# MUHIM: kalitni bazadan ALOHIDA saqlang (hosting "Environment/Secrets"da) va zaxiralang — yo'qolsa, ma'lumotni tiklab bo'lmaydi.
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
TERMCHAT_MASTER_KEY=
# 1 (standart): /api va /uploads faqat shifrlangan kanal (/api/x) orqali ochiladi. 0 — faqat testlar uchun.
TERMCHAT_REQUIRE_TUNNEL=1

# --- E2EE ---
# 1 (standart): server ochiq matnli xabarni umuman qabul qilmaydi, faqat E2EE konvert. 0 — faqat eski testlar uchun.
TERMCHAT_REQUIRE_E2EE=1
